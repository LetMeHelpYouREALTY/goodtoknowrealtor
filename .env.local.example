# WordPress API Configuration
# IMPORTANT: This is for LOCAL DEVELOPMENT ONLY
# For Vercel deployments, add these in Project Settings → Environment Variables
# See ENVIRONMENT_VARIABLES.md for detailed setup instructions

# Blog source for content scraping
BLOG_SOURCE_URL=https://www.bhhscp.com/blog

# WordPress REST API endpoint (server-side)
WORDPRESS_API_URL=https://www.bhhscp.com/wp-json/wp/v2

# Secret for ISR revalidation endpoint
# Generate with: openssl rand -base64 32
# MUST be marked as SENSITIVE in Vercel dashboard
REVALIDATE_SECRET=your-secret-key-here-min-32-chars

# Public variables (exposed to browser - safe for public APIs)
NEXT_PUBLIC_WORDPRESS_API_URL=https://www.bhhscp.com/wp-json/wp/v2
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# WordPress Authentication (optional - for private posts)
# Get from WordPress Admin → Users → Profile → Application Passwords
# NEVER use NEXT_PUBLIC_ prefix for these!
# MUST be marked as SENSITIVE in Vercel dashboard
WORDPRESS_USER=your_wordpress_username
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Legacy compatibility (auto-synced with above)
# MUST be marked as SENSITIVE in Vercel dashboard
WP_USER=your_wordpress_username
WP_APP_PASS=xxxx xxxx xxxx xxxx xxxx xxxx

# Platform detection (auto-set by Vercel in production)
VERCEL=0

# Optional: Google Analytics (if using)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Google Tag Manager (if using)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Optional: Google Site Verification
# GOOGLE_SITE_VERIFICATION=your-verification-code

# =============================================================================
# SECURITY NOTES:
# =============================================================================
# 1. NEVER commit .env.local to git (already in .gitignore)
# 2. Use different credentials for Dev/Preview/Production environments
# 3. Mark these as SENSITIVE in Vercel dashboard:
#    - REVALIDATE_SECRET
#    - WORDPRESS_APP_PASSWORD
#    - WP_APP_PASS
# 4. Variables with NEXT_PUBLIC_ are exposed to the browser
# 5. Generate strong secrets (32+ chars) for REVALIDATE_SECRET
# 6. Rotate secrets every 90 days
# 7. See ENVIRONMENT_VARIABLES.md for complete setup guide
